# Repo-root .env.example — reference for the environment variables the
# services actually read today. No real values here; this is a reference,
# not a working config.
#
# Each service reads the SAME variable names from its own process
# environment: DATABASE_URL (required), NATS_URL (required), and
# LISTEN_ADDR (optional, per-service default below). So this file is a
# per-service cheat sheet, not something to source as-is — exporting one
# DATABASE_URL would point every service at the same database.
#
# Each service ALSO has its own .env.example holding POSTGRES_USER /
# POSTGRES_PASSWORD / POSTGRES_DB / NATS_URL; copy that to .env next to
# it, because infra/docker/docker-compose.yml uses it as the env_file for
# that service's Postgres container.
#
# Host ports below come from infra/docker/docker-compose.yml (every
# container listens on 5432 internally).

# --- ledger-service (Go, Postgres) ---
# DATABASE_URL=postgres://ledger:ledger@localhost:5433/ledger?sslmode=disable
# LISTEN_ADDR=:8080   (default when unset)

# --- accounts-service (Go, Postgres) ---
# DATABASE_URL=postgres://accounts:accounts@localhost:5434/accounts?sslmode=disable
# LISTEN_ADDR=:8081   (default when unset)

# --- settlement-engine (Go, Postgres) ---
# Owns a Postgres database of its own (transactions, settlements,
# blocklist, outbox_events — see internal/db/migrations).
# DATABASE_URL=postgres://settlement:settlement@localhost:5435/settlement?sslmode=disable
# LISTEN_ADDR=:8082   (default when unset)
#
# Optional risk/batching knobs read by settlement-engine only. Values
# shown are the built-in defaults.
# SETTLEMENT_VELOCITY_LIMIT=5
# SETTLEMENT_VELOCITY_WINDOW_MINUTES=5
# SETTLEMENT_MISMATCH_THRESHOLD=10000000
# SETTLEMENT_BATCH_INTERVAL_SECONDS=60

# --- notification-service (Python, Postgres) ---
# Owns a Postgres database of its own (notifications — see
# internal/db/migrations). Terminal consumer: publishes nothing, and has
# no email/push delivery channel yet, so no provider keys are read.
# DATABASE_URL=postgres://notification:notification@localhost:5436/notification?sslmode=disable
# LISTEN_ADDR=:8083   (default when unset)

# --- Event broker (shared across all four services) ---
# NATS JetStream (decided 2026-08-10). Required, no default.
NATS_URL=nats://localhost:4222

# --- mobile-app (Expo/TypeScript) ---
# Has its own mobile-app/.env.example with EXPO_PUBLIC_* base URLs
# pointing at the four services above.
