# Repo-root .env.example — documents what each service will need.
# Copy relevant sections into each service's own .env when it's implemented.
# No real values here; this is a reference, not a working config.

# --- accounts-service (Go, Postgres) ---
ACCOUNTS_SERVICE_DB_URL=postgres://user:password@localhost:5432/accounts?sslmode=disable
ACCOUNTS_SERVICE_PORT=8081

# --- ledger-service (Go, Postgres) ---
LEDGER_SERVICE_DB_URL=postgres://user:password@localhost:5432/ledger?sslmode=disable
LEDGER_SERVICE_PORT=8082

# --- settlement-engine (Go) ---
# No direct DB of its own yet (consumes ledger events) — add
# SETTLEMENT_ENGINE_DB_URL here if/when it gains owned state.
SETTLEMENT_ENGINE_PORT=8083

# --- notification-service (Python) ---
# No direct DB — subscribes to risk-hold / settlement-finalized events only.
NOTIFICATION_SERVICE_PORT=8084
# Push/email provider keys — placeholders until a provider is chosen.
NOTIFICATION_PUSH_API_KEY=
NOTIFICATION_EMAIL_API_KEY=

# --- Event broker (shared across services) ---
# Technology TBD (Kafka, NATS, RabbitMQ, etc. — see CLAUDE.md Architecture).
# Rename this once a broker is chosen (e.g. KAFKA_BROKERS, NATS_URL).
EVENT_BROKER_URL=
