      "Bash(rtk git branch -D*)",
      "Bash(rtk git branch -d *)",
      "Bash(rtk git branch --delete*)",
      "Bash(rtk git push *--delete*)",
      "Bash(rtk git clean -f*)",
      "Bash(rtk git clean -*f*)",
      "Bash(rtk dropdb*)",
      "PowerShell(yarn*)",
      "PowerShell(pnpm*)",
      "PowerShell(bun *)",
      "PowerShell(bunx *)",
      "PowerShell(poetry*)",
